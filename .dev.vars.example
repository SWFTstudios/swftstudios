# Copy to .dev.vars for local `npx wrangler pages dev` / `wrangler dev` (never commit .dev.vars).
# Production: VERIFY RESEND_API_KEY exists on the Pages project swftstudios-website.
# If swftstudios.com routes through a separately deployed Worker, set the same secret there.
# An API key in one Cloudflare project/environment is NOT automatically shared with another.
# Rotate with: npx wrangler pages secret put RESEND_API_KEY --project-name=swftstudios-website
# Optional: also set STRIPE_SECRET_KEY the same way.
# Optional Google Sheets lead log: GOOGLE_SHEETS_WEBHOOK_URL + GOOGLE_SHEETS_SECRET (docs/GOOGLE_SHEETS_LEADS.md).

RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=SWFT Studios <hello@swftstudios.com>
# NOTIFY_EMAIL=elombe@swftstudios.com
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# PORTAL_ADMIN_SECRET=generate-a-long-random-string
# POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxx
# POSTHOG_PROJECT_ID=486061
# PORTAL_ORIGIN=http://127.0.0.1:8787
# Optional Price ID overrides (defaults in data/stripe-catalog.json):
# STRIPE_PRICE_GBP_REFRESH=price_1U6c9zAF4d9gCyuNIaEa8MhT
# STRIPE_PRICE_WEBSITE_ONLY=price_1U6cA5AF4d9gCyuNj65BmDU2
# STRIPE_PRICE_WEBSITE_CONTENT_HALF=price_1U6cA8AF4d9gCyuNt2PH1qew
# STRIPE_PRICE_WEBSITE_CONTENT_FULL=price_1U6cAAAF4d9gCyuNeB6qUFx5
# STRIPE_PRICE_CONTENT_GROWTH_RETAINER=price_1U6cA8AF4d9gCyuN0Ko807my
# STRIPE_PRICE_FULL_GROWTH_PARTNER=price_1U6cAAAF4d9gCyuN6yvZR5im
# Booking pill availability (GET /api/availability) reads public slots from
# cal.com/swftstudios/swft-meeting. Only set a key if the event type is private.
# CAL_API_KEY=cal_live_xxxxxxxx
# CAL_USERNAME=swftstudios
# CAL_EVENT_SLUG=swft-meeting
