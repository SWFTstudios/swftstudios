# Copy to .dev.vars for local `npx wrangler pages dev` / `wrangler dev` (never commit .dev.vars).
# Production: already set on Pages project swftstudios-website as RESEND_API_KEY
# Rotate with: npx wrangler pages secret put RESEND_API_KEY --project-name=swftstudios-website
# Optional: also set AIRTABLE_TOKEN and STRIPE_SECRET_KEY the same way.

RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=SWFT Studios <hello@swftstudios.com>
# NOTIFY_EMAIL=hello@swftstudios.com
# AIRTABLE_TOKEN=
# STRIPE_SECRET_KEY=
