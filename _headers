# CSS and JS links carry a ?v= version, and these files still revalidate on every
# visit, so a deploy shows up right away instead of waiting out a browser/CDN cache.
# (Pages already serves HTML with max-age=0, must-revalidate.)
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/fonts/*
  Cache-Control: public, max-age=604800
/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/api/admin/*
  Cache-Control: no-store

# Installable web app: the service worker and manifest must never be stale.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=0, must-revalidate
