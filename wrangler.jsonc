{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "swftstudios",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-09",
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swft-portal",
      "database_id": "dfd16777-238c-4679-a8e2-68a5bf9b707b",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "exclude": [
      ".git",
      "**/.git/**",
      ".wrangler",
      "**/.wrangler/**",
      ".cursor",
      "**/.cursor/**",
      "node_modules",
      "**/node_modules/**",
      "src",
      "**/src/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json"
    ]
  }
}
